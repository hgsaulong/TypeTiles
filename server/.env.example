PORT=3001
# Generate independent random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production requires a strong configured JWT secret; missing/weak development JWT uses a random
# process-local secret (sessions then expire on restart). Never deploy placeholders.
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
PASSWORD_RESET_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_SECRET
EMAIL_VERIFICATION_SECRET=REPLACE_WITH_ANOTHER_INDEPENDENT_RANDOM_64_HEX_SECRET
# Offline/local defaults. Choose postgres for the online Supabase backend.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/typetiles.db
# PostgreSQL only: copy the URI from Supabase Connect > Session pooler.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_MAX=5
# Optional PEM root certificate path if required by your Supabase endpoint.
# DATABASE_SSL_CA_FILE=./supabase-root.crt
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Backend only. Use a sender authorized in your Resend account.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_API_KEY
RESEND_FROM_EMAIL=Type Tiles <no-reply@your-verified-domain.example>
# One fixed recipient for the development-only email:test script.
RESEND_TEST_TO_EMAIL=your-test-inbox@example.com
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres"


