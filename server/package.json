{
  "name": "type-tiles-server",
  "version": "1.0.0",
  "description": "TypeTiles backend server with authentication and multiplayer support",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:verification-test": "tsx scripts/verificationTestDb.ts",
    "db:verification-test:init": "tsx scripts/verificationTestDb.ts --init",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:reset": "node scripts/resetDb.js",
    "email:test": "tsx scripts/testEmail.ts",
    "test:auth": "tsx --test tests/passwordReset.test.ts tests/emailVerification.test.ts",
    "test:sentences": "tsx --test tests/sentencePractice.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "resend": "^6.32.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
